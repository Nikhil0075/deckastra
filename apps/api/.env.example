# Development: free deterministic planner. Never use stub in production.
DECKASTRA_ENV=development
DECKASTRA_INTELLIGENCE=stub

# Hosted service configuration; deploy script injects these and Secret Manager values.
# DATABASE_URL is a secret, never checked into Git or shipped to the desktop.
# DECKASTRA_ENV=production
# DECKASTRA_INTELLIGENCE=vertex
# DECKASTRA_ASSISTANT_MODE=vertex
# GOOGLE_CLOUD_PROJECT=deckastra
# DECKASTRA_VERTEX_PROJECT=deckastra
# DECKASTRA_VERTEX_LOCATION=global
# DECKASTRA_VERTEX_IDENTITY=attached
# DECKASTRA_VERTEX_MODELS={}
# DECKASTRA_VERTEX_PRICES={}
# DECKASTRA_VERTEX_THINKING={}
# DECKASTRA_VERTEX_QUALIFICATION=/app/evaluations/independently-reviewed.json
# Models remain disabled until exact-model evaluation and verified prices exist.
# DECKASTRA_CREDITS_ENABLED=1
# DECKASTRA_ASSISTANT_MAX_COST_USD=0.30
# DECKASTRA_ACCOUNT_DAILY_USD=0.30
# DECKASTRA_DEVICE_DAILY_USD=0.30
# DECKASTRA_GLOBAL_DAILY_USD=10
# DECKASTRA_DAILY_REQUEST_CAP=200
# DECKASTRA_OIDC_ISSUER=https://securetoken.google.com/deckastra
# DECKASTRA_OIDC_AUDIENCE=deckastra
# DECKASTRA_WEB_ORIGINS=http://localhost:3000
# DECKASTRA_GCS_ASSETS_BUCKET=deckastra-assets
# DECKASTRA_GCS_EXPORTS_BUCKET=deckastra-exports
# DECKASTRA_GCS_SERVICE_ACCOUNT=deckastra-api@deckastra.iam.gserviceaccount.com
# DECKASTRA_UPLOAD_SECRET and DECKASTRA_DEVICE_SECRET: Secret Manager only.

# Optional local MinIO (infrastructure/docker/docker-compose.yml).
# S3_ENDPOINT_URL=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=deckastra
# S3_SECRET_ACCESS_KEY=deckastra_local
# S3_ASSETS_BUCKET=deckastra-assets
