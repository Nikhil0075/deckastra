{
  "name": "@deckastra/deck-presets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Reviewed, deterministic starting points for Deckastra decks.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./generated/*": "./generated/*"
  },
  "files": [
    "src",
    "generated"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "presets:emit": "tsx scripts/emit.ts",
    "presets:catalog": "tsx scripts/emit.ts --check",
    "presets:exports": "python -m pytest ../../apps/api/tests/test_preset_exports.py -q",
    "presets:fidelity": "python scripts/fidelity.py",
    "presets:showcase": "python scripts/design-system-showcase.py",
    "presets:patterns": "python scripts/preview-sheet.py --patterns --strict --duplicate-bits 8 --out ../../.artifacts/design-system-v2-families",
    "presets:languages": "python scripts/preview-sheet.py --languages --strict --out ../../.artifacts/design-language-gate",
    "presets:check": "npm run presets:catalog && npm run presets:patterns && npm run presets:languages && npm run presets:exports && npm run presets:fidelity",
    "contact-sheet": "tsx scripts/emit.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
