{
  "name": "@deckastra/renderer",
  "version": "0.0.0",
  "description": "Deterministic interpreter of the .mydeck model: document -> IntermediateScene -> DOM/SVG. Owns no state.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.tsx",
    "./perf": "./src/perf.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/pixels.test.ts",
    "test:watch": "vitest",
    "test:pixels": "vitest run tests/pixels.test.ts --maxWorkers=1 --minWorkers=1"
  },
  "dependencies": {
    "@deckastra/layout-engine": "*",
    "@deckastra/presentation-schema": "*",
    "katex": "^0.18.9"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@deckastra/animation-engine": "*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
