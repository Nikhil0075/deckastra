# Copy to .env and fill in, or export these in your shell.
#
# Without a key the API composes decks with the deterministic stub planner and
# says so in every response — the whole path still works, it just writes
# placeholder copy.
ANTHROPIC_API_KEY=

# Production authentication. Deckastra accepts RS256 OIDC bearer tokens from
# one exact issuer/audience. Tokens must contain `email` and
# `email_verified: true`; configure those claims in the provider's token
# template. Set AUTHORIZED_PARTIES when the provider emits an `azp` claim.
# DECKASTRA_ENV=production
# DECKASTRA_OIDC_ISSUER=https://your-tenant.example.com
# DECKASTRA_OIDC_AUDIENCE=deckastra-api
# DECKASTRA_OIDC_JWKS_URL=https://your-tenant.example.com/.well-known/jwks.json
# DECKASTRA_OIDC_AUTHORIZED_PARTIES=http://localhost:3000,https://app.example.com
# Local/test escape hatch only; production should use JWKS rotation:
# DECKASTRA_OIDC_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Where the web app expects the API. Only needed if you move it off :8000.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# S3-compatible object storage. These defaults match the local Docker compose.
# S3_ENDPOINT_URL=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=deckastra
# S3_SECRET_ACCESS_KEY=deckastra_local
# S3_ASSETS_BUCKET=deckastra-assets
# Use a separate random value in production to sign upload-completion tokens.
# DECKASTRA_UPLOAD_SECRET=replace-with-a-long-random-secret
# Presentation Assistant: explicit server configuration, never browser credentials.
# DECKASTRA_ASSISTANT_MODE=hybrid
# DECKASTRA_ASSISTANT_PACK=gemma4-e2b-q4
# DECKASTRA_ASSISTANT_QUALIFICATION=/absolute/path/to/reviewed-e2b-report.json
# DECKASTRA_ASSISTANT_RUNTIME=b11146-cuda12.4
# DECKASTRA_ASSISTANT_HARDWARE=deployment-specific-hardware-identity
# DECKASTRA_VERTEX_PROJECT=deckastra
# DECKASTRA_VERTEX_LOCATION=global
# DECKASTRA_WEB_ORIGINS=http://localhost:3000,https://your-configured-web-origin
# DECKASTRA_VERTEX_THINKING={"evaluated-pinned-model":"LOW"}
# DECKASTRA_GOOGLE_CREDENTIALS=/server/path/to/google-credentials.json
# Or DECKASTRA_VERTEX_IDENTITY=attached for a configured attached identity.
# DECKASTRA_VERTEX_MODELS={"default":"evaluated-pinned-model","image":"configured-image-model"}
# DECKASTRA_VERTEX_PRICES={"evaluated-pinned-model":{"input":"verified-input-price","output":"verified-output-price"}}
# Replace price placeholders with verified model pricing before execution.
# DECKASTRA_ASSISTANT_MAX_COST_USD=5
# DECKASTRA_ASSISTANT_COST_LEDGER=/persistent/shared/assistant-cost.sqlite
# DECKASTRA_SPEECH_USD_PER_MILLION=verified-speech-price
# See docs/integrations/02_ASSISTANT_IMPLEMENTATION.md.
