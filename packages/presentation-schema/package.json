{
  "name": "@deckastra/presentation-schema",
  "version": "0.0.0",
  "description": "Canonical .mydeck document model: types, runtime validators, JSON Schema, and fixtures. The source of truth for every other package.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./fixtures": "./src/fixtures.ts",
    "./fixtures/*": "./fixtures/*",
    "./generated/*": "./generated/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "generated",
    "fixtures"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema:emit": "tsx scripts/emit-json-schema.ts",
    "schema:drift": "tsx scripts/emit-json-schema.ts --check",
    "fixtures:build": "tsx scripts/build-fixtures.ts"
  },
  "dependencies": {
    "ulid": "^2.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
