node_modules/
dist/
build/
# electron-builder's `buildResources` directory, which is source rather than
# output: the macOS entitlements the hardened runtime needs live there, and the
# blanket `build/` rule above had them ignored — so the packaging config would
# have pointed at a file a clean checkout does not contain, and the first sign
# of it would have been a release build failing on someone else's machine.
!apps/desktop/build/
!apps/desktop/build/**
.next/
out/
coverage/
.artifacts/
artifacts/
*.tsbuildinfo

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

.env
.env.local
.env.*.local
infrastructure/deployment/state/
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
!.env.example

.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Generated schema artifacts are committed on purpose (see packages/presentation-schema/README.md)
# so CI can diff them for drift. Nothing else generated is.

# Next.js
.next/
next-env.d.ts

# Pixel hashes a run computed when no baseline existed. An artifact for
# recording the first baseline on a platform, never a committed file.
*.computed
packages/renderer/baselines/pixels/artifacts/

# Electron packaging output (apps/desktop). Installers are build artifacts.
release/

# Local MCP wiring: absolute paths for one machine, and it names how this
# checkout is reached. Each developer writes their own (apps/mcp-server/README).
.mcp.json

# Claude Code's scratch worktrees.
.claude/worktrees/

# A placeholder some tool leaves behind. This repository uses npm workspaces;
# a pnpm workspace file here describes a layout nothing reads.
pnpm-workspace.yaml

# Third-party binaries fetched for packaging (e.g. the audited ffmpeg).
# Large and redistributed under their own licences; never committed.
/vendor/
