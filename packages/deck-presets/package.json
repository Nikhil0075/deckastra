{
  "name": "@deckastra/deck-presets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Reviewed, deterministic starting points for Deckastra decks.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./generated/*": "./generated/*"
  },
  "files": [
    "src",
    "generated"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "presets:emit": "tsx scripts/emit.ts",
    "presets:catalog": "tsx scripts/emit.ts --check",
    "presets:exports": "python -m pytest ../../apps/api/tests/test_preset_exports.py -q",
    "presets:check": "npm run presets:catalog && npm run presets:exports",
    "contact-sheet": "tsx scripts/emit.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
