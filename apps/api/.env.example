# Copy to .env and fill in, or export these in your shell.
#
# Without a key the API composes decks with the deterministic stub planner and
# says so in every response — the whole path still works, it just writes
# placeholder copy.
ANTHROPIC_API_KEY=

# Production authentication. Deckastra accepts RS256 OIDC bearer tokens from
# one exact issuer/audience. Tokens must contain `email` and
# `email_verified: true`; configure those claims in the provider's token
# template. Set AUTHORIZED_PARTIES when the provider emits an `azp` claim.
# DECKASTRA_ENV=production
# DECKASTRA_OIDC_ISSUER=https://your-tenant.example.com
# DECKASTRA_OIDC_AUDIENCE=deckastra-api
# DECKASTRA_OIDC_JWKS_URL=https://your-tenant.example.com/.well-known/jwks.json
# DECKASTRA_OIDC_AUTHORIZED_PARTIES=http://localhost:3000,https://app.example.com
# Local/test escape hatch only; production should use JWKS rotation:
# DECKASTRA_OIDC_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Where the web app expects the API. Only needed if you move it off :8000.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# S3-compatible object storage. These defaults match the local Docker compose.
# S3_ENDPOINT_URL=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=deckastra
# S3_SECRET_ACCESS_KEY=deckastra_local
# S3_ASSETS_BUCKET=deckastra-assets
# Use a separate random value in production to sign upload-completion tokens.
# DECKASTRA_UPLOAD_SECRET=replace-with-a-long-random-secret
